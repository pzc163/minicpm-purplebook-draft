# 代码和课程使用 LF；原始补丁、公开证据保持发布包中的字节
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.kt text eol=lf
*.md text eol=lf
*.ipynb text eol=lf
*.jpg binary
*.png binary

# unified diff 的空上下文行以一个空格开头，不删除该空格
android/patches/*.patch -text whitespace=-blank-at-eol
# CSV/证书可含 CRLF，测试 stdout 可含末尾空行，保留原测量文件
results/published/** -text whitespace=-blank-at-eol,-blank-at-eof
